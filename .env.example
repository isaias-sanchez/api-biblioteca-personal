PORT=3000
DB_PATH=./biblioteca.db

# ── Asistente Contable Obras ──────────────────────────────────────────────────

# Anthropic (Claude) — REQUERIDO para procesar mensajes y facturas con IA
ANTHROPIC_API_KEY=sk-ant-...

# URL base del servidor (para links en respuestas de WhatsApp)
BASE_URL=https://tu-dominio.com

# Ruta de la base de datos de obras (opcional, default: ./construccion.db)
CONSTRUCCION_DB_PATH=./construccion.db

# Ruta de almacenamiento de imágenes de facturas (opcional)
FACTURAS_DIR=./uploads/facturas

# ── WhatsApp via Twilio (opción más fácil) ────────────────────────────────────
# Obtener en: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Número de WhatsApp de Twilio (sin el prefijo whatsapp:)
TWILIO_WHATSAPP_FROM=+14155238886

# ── WhatsApp via Meta Business API (producción) ───────────────────────────────
# Token de verificación del webhook (puedes poner cualquier string)
WHATSAPP_VERIFY_TOKEN=mi_token_secreto_123
# Access token de la app de Meta
META_ACCESS_TOKEN=EAAxxxxxxx...

# ── Transcripción de notas de voz (opcional) ──────────────────────────────────
# Si lo configuras, el bot podrá entender notas de voz vía OpenAI Whisper
OPENAI_API_KEY=sk-...
